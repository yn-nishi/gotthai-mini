{
  "name": "ごったいmini",
  "short_name": "mini",
  "author": "yn-nishi",
  "description" : "いつでもあなたにごったいを。",
  "version": "4.0.1",
  "manifest_version": 3,
  "permissions": ["activeTab","storage", "offscreen"],
  "background": {
    "service_worker": "scripts/background.js"
  },
   "host_permissions": ["https://www.gotthai.net/","https://translate.google.com/"],
  "action": {
    "name": "Gotthai-mini",
    "default_popup": "html/popup.html",
    "default_icon": {
      "16": "icons/gotthai_16.png",
      "32": "icons/gotthai_32.png",
      "48": "icons/gotthai_48.png",
      "128": "icons/gotthai_128.png"
    }
  },
  "icons": {
    "16": "icons/gotthai_16.png",
    "32": "icons/gotthai_32.png",
    "48": "icons/gotthai_48.png",
    "128": "icons/gotthai_128.png"
  },
  "web_accessible_resources": [{
    "resources": ["css/bubble_box.css"],
    "matches": ["<all_urls>"]
  }],
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["scripts/bubble_box.js"]
  }]
 }
